---
const { time, title, description } = Astro.props;
---

<li class="group flex gap-3">
    <div class="flex flex-col items-center">
        <div class="h-1.5 w-0.5 bg-black dark:bg-white group-first:invisible"></div>
        <div class="h-3 w-3 shrink-0 border-2 border-black bg-white dark:border-white dark:bg-neutral-800"></div>
        <div class="w-0.5 flex-1 bg-black dark:bg-white group-last:invisible"></div>
    </div>
    <div class="pb-4">
        <div class="text-sm text-zinc-500 dark:text-zinc-400">{time}</div>
        <div class="font-bold">{title}</div>
        <p class="text-zinc-700 dark:text-zinc-300">{description}</p>
    </div>
</li>
