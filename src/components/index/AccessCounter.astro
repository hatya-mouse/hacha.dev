<div class="flex flex-row gap-2 items-baseline">
    <div id="access-counter" class="px-1 tracking-widest border-outset">
        ------
    </div>
    <div>visits</div>
</div>

<script>
    document.addEventListener("astro:page-load", async () => {
        const counter = document.getElementById("access-counter");
        if (!counter) return;
        const counted = sessionStorage.getItem("site_counted");
        const res = await fetch("/api/count", {
            method: counted ? "GET" : "POST",
        });
        if (!res.ok) return;
        const { count } = await res.json<{ count: number }>();
        if (!counted) sessionStorage.setItem("site_counted", "1");
        counter.textContent = String(count).padStart(6, "0");
    });
</script>
