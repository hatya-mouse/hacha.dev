---
import AccessCounter from "./AccessCounter.astro";
import headerImage from "../assets/images/header.png";
import headerImageDark from "../assets/images/header_dark.png";
import DarkImage from "./DarkImage.astro";

const { lang } = Astro.props;
---

<header class="bg-sky-200 dark:bg-slate-800">
    <div class="px-4 pt-2 flex gap-2 items-center justify-between">
        <a href="/">hacha.dev</a>
        <AccessCounter />
    </div>

    <DarkImage
        lightSrc={headerImage.src}
        darkSrc={headerImageDark.src}
        alt="Header"
        imgClass="pixel-art w-full"
    />

    <div class="px-4 py-2 flex flex-wrap gap-x-4 gap-y-2 justify-between bg-neutral-100 dark:bg-neutral-700">
        {lang == "en" ? (
            <>
                <div class="flex flex-wrap gap-x-4 gap-y-2 justify-between">
                    <a href="/">Home</a>
                    <a href="/projects">Projects</a>
                </div>
                <a href="/ja">JA</a>
            </>
        ) : (
            <>
                <div class="flex flex-wrap gap-x-4 gap-y-2 justify-between">
                    <a href="/ja">トップ</a>
                    <a href="/ja/projects">作品</a>
                </div>
                <a href="/">EN</a>
            </>
        )}

        <!-- <a href="/fireplace">Fireplace</a> -->
    </div>
</header>
