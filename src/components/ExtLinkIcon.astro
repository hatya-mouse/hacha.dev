---
import extLinkImage from "../assets/images/icons/external.png";
import extLinkImageDark from "../assets/images/icons/external_dark.png";
import DarkImage from "./DarkImage.astro";
---

<DarkImage
    class="inline-block w-4 h-4 align-middle"
    lightSrc={extLinkImage.src}
    darkSrc={extLinkImageDark.src}
    width="16"
    height="16"
    alt="External Link"
    imgClass="pixel-art w-full h-full"
/>
