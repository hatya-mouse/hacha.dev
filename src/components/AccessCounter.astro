---
const { lang } = Astro.props;
---

<div class="flex flex-row gap-2 items-baseline">
    {lang !== "en" && <div>訪問者数</div>}
    <div
        id="access-counter"
        class="px-1 tracking-widest border-outset bg-gray-100 dark:bg-neutral-800"
    >
        ------
    </div>
    {lang === "en" && <div>visits</div>}
</div>

<script>
    document.addEventListener("astro:page-load", () => {
        const counter = document.getElementById("access-counter");
        if (!counter) return;

        setTimeout(async () => {
            if (new URLSearchParams(location.search).has("ignore")) {
                localStorage.setItem("ignore_count", "1");
            }

            const skip =
                sessionStorage.getItem("site_counted") ||
                localStorage.getItem("ignore_count");
            const res = await fetch("/api/count", {
                method: skip ? "GET" : "POST",
            });
            if (!res.ok) return;
            const { count } = await res.json<{ count: number }>();
            if (!skip) sessionStorage.setItem("site_counted", "1");
            counter.textContent = String(count).padStart(6, "0");
        }, 0);
    });
</script>
