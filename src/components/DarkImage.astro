---
const {
    lightSrc,
    darkSrc,
    width,
    height,
    alt,
    imgClass,
    class: className,
} = Astro.props;
---

<picture class={className}>
    <source
        srcset={darkSrc}
        class={imgClass}
        media="(prefers-color-scheme: dark)"
    />
    <img
        src={lightSrc}
        width={width}
        height={height}
        alt={alt}
        class={imgClass}
    />
</picture>
