---
import "../styles/global.css";
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <!-- Google Analytics -->
        <script
            async
            src="https://www.googletagmanager.com/gtm.js?id=GTM-MCZF2TRC"
        ></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                dataLayer.push(arguments);
            }
            gtag("js", new Date());
        </script>

        <!-- Metadata -->
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />

        <!-- Favicon and app name -->
        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <meta name="apple-mobile-web-app-title" content="hacha.dev" />
        <link rel="manifest" href="/site.webmanifest" />

        <meta name="generator" content={Astro.generator} />
        <title>hacha.dev</title>
        <Head />
    </head>
    <body class="flex min-h-dvh justify-center bg-zinc-200 dark:bg-neutral-900">
        <div class="max-w-2xl w-full min-h-dvh bg-white dark:bg-neutral-800 flex flex-col">
            <Header />
            <main class="px-4 py-2 flex-1">
                <slot />
            </main>
            <Footer />
        </div>
    </body>
</html>

<style>
    html,
    body {
        font-family: var(--font-google-sans-code);
    }
</style>
