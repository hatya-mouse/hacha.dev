---
import { ClientRouter } from "astro:transitions";
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
    <head>
        <title>hacha.dev</title>
        <Head />
        <ClientRouter />
    </head>
    <body class="flex min-h-dvh justify-center bg-zinc-200 dark:bg-neutral-900">
        <!-- Hey why are you looking at this -->

        <div class="max-w-2xl w-full min-h-dvh bg-white dark:bg-neutral-800 flex flex-col">
            <Header />
            <main class="px-4 py-2 flex-1">
                <slot />
            </main>
            <Footer />
        </div>
    </body>
</html>

<style>
    html,
    body {
        font-family: var(--font-google-sans-code);
    }
</style>
