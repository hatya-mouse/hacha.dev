---
import { ClientRouter } from "astro:transitions";
import { useLanguage } from "@/i18n/utils";
import Head from "@/components/Head.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import "@/styles/global.css";

const { title, lang: preferredLang } = Astro.props;
const lang = useLanguage(preferredLang);
---

<!doctype html>
<html lang="en">
    <head>
        <title>{title ?? "hacha.dev"}</title>
        <Head />
        <ClientRouter />
    </head>
    <body
        class="flex min-h-dvh justify-center bg-zinc-200 dark:bg-neutral-900"
        transition:animate="none"
    >
        <!-- Hey why are you looking at this -->

        <div class="max-w-2xl w-full min-h-dvh bg-white dark:bg-neutral-800 flex flex-col">
            <Header lang={lang} />
            <main class="px-4 py-2 flex-1">
                <slot />
            </main>
            <Footer />
        </div>
    </body>
</html>

<style>
    html,
    body {
        font-family: var(--font-google-sans-code);
    }
</style>
