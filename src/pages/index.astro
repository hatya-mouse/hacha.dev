---
import { Image } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import headerImage from "../assets/images/header.png";
import Layout from "../layouts/Layout.astro";
import AccessCounter from "../components/AccessCounter.astro";
---

<ClientRouter />

<Layout>
    <header class="bg-sky-200 dark:bg-slate-800">
        <div class="h-10 px-4 flex flex-row gap-2 items-center justify-start">
            <a href="/">hacha.dev</a>
        </div>

        <img src={headerImage.src} alt="Header" class="pixel-art w-full" />
    </header>

    <main class="px-4 py-2">
        <div class="flex justify-center mt-2">
            <AccessCounter />
        </div>

        <h1>Home</h1>
        <p>Welcome to my website!</p>
        <p>I'm a student at Kosen (工業高等専門学校) in Japan</p>
    </main>
</Layout>
