---
import Layout from "@/layouts/Layout.astro";
import ExtLinkIcon from "@/components/ExtLinkIcon.astro";
import Timeline from "@/components/index/Timeline.astro";
import TimelineItem from "@/components/index/TimelineItem.astro";

import normalImage from "@/assets/images/avatar/normal.png";
import shogatsuImage from "@/assets/images/avatar/shogatsu.png";
import hinaningyoImage from "@/assets/images/avatar/hinaningyo.png";
import helloweenImage from "@/assets/images/avatar/helloween.png";
import christmasImage from "@/assets/images/avatar/christmas.png";
import omisokaImage from "@/assets/images/avatar/omisoka.png";

import xImage from "@/assets/images/icons/x.png";
import xImageDark from "@/assets/images/icons/x_dark.png";
import ghImage from "@/assets/images/icons/gh.png";
import ghImageDark from "@/assets/images/icons/gh_dark.png";
import instaImage from "@/assets/images/icons/insta.png";
import instaImageDark from "@/assets/images/icons/insta_dark.png";
import linImage from "@/assets/images/icons/lin.png";
import linImageDark from "@/assets/images/icons/lin_dark.png";
import DarkImage from "@/components/DarkImage.astro";

let avatarSrc = normalImage.src;
const today = new Date();
const m = today.getMonth() + 1;
const d = today.getDate();

if (m == 1 && d >= 1 && d <= 3) {
    avatarSrc = shogatsuImage.src;
} else if (m == 3 && d == 3) {
    avatarSrc = hinaningyoImage.src;
} else if (m == 10 && d >= 29) {
    avatarSrc = helloweenImage.src;
} else if (m == 12 && d >= 23 && d <= 25) {
    avatarSrc = christmasImage.src;
} else if (m == 12 && d == 31) {
    avatarSrc = omisokaImage.src;
}
---

<Layout>
    <h1>Welcome</h1>
    <p>Thank you for visiting my website!</p>
    <p>Feel free to look around~</p>

    <h2>Profile</h2>
    <div class="flex sm:gap-4 gap-2 sm:flex-row flex-col">
        <img
            src={avatarSrc}
            alt="Profile Picture"
            class="pixel-art max-w-32 w-full max-h-32 aspect-square"
        />
        <div>
            <p class="text-lg">Hacha Mouse</p>
            <p>Name: Shuntaro Kasatani</p>
            <p>Birthday: March 19</p>
            <p>Location: Japan</p>
            <p>
                Education:&nbsp;
                <a
                    href="https://nagano-nct.ac.jp"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    National Institute of Technology (KOSEN), Nagano
                    College&nbsp;
                    <ExtLinkIcon />
                </a>
            </p>
        </div>
    </div>
    <p>Hello! I'm Hacha Mouse. I'm a computer science student in Japan.</p>

    <h2>Social Accounts</h2>
    <div class="flex flex-col gap-4">
        <a
            href="https://github.com/hatya-mouse"
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-row gap-4 items-center justify-start"
        >
            <DarkImage
                class="w-8 h-8"
                lightSrc={ghImage.src}
                darkSrc={ghImageDark.src}
                alt="GitHub"
                imgClass="pixel-art w-full"
            />
            hatya-mouse
        </a>

        <a
            href="https://x.com/hachanezu_mouse"
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-row gap-4 items-center justify-start"
        >
            <DarkImage
                class="w-8 h-8"
                lightSrc={xImage.src}
                darkSrc={xImageDark.src}
                alt="X"
                imgClass="pixel-art w-full"
            />
            @hachanezu_mouse
        </a>

        <a
            href="https://www.instagram.com/hacha_mouse/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-row gap-4 items-center justify-start"
        >
            <DarkImage
                class="w-8 h-8"
                lightSrc={instaImage.src}
                darkSrc={instaImageDark.src}
                alt="Instagram"
                imgClass="pixel-art w-full"
            />
            hacha_mouse
        </a>

        <a
            href="https://www.linkedin.com/in/shuntaro-kasatani-68bb17411/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-row gap-4 items-center justify-start"
        >
            <DarkImage
                class="w-8 h-8"
                lightSrc={linImage.src}
                darkSrc={linImageDark.src}
                alt="LinkedIn"
                imgClass="pixel-art w-full"
            />
            Shuntaro Kasatani
        </a>
    </div>

    <h2>Timeline</h2>
    <Timeline>
        <TimelineItem time="2010" title="Born in Tokyo" />
        <TimelineItem time="2013" title="Moved to Kobe" />
        <TimelineItem time="2022" title="Moved to Nagano" />
        <TimelineItem
            time="2025 - Present"
            title="National Institute of Technology (KOSEN), Nagano College"
        />
    </Timeline>
</Layout>
