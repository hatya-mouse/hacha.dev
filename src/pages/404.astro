---
import Layout from "@/layouts/Layout.astro";
---

<Layout>
    <h1 class="text-yellow-700 dark:text-amber-500">404</h1>
    What,
    <span id="not-found-path" class="text-teal-700 dark:text-teal-500" />? I
    don't know such a page.
</Layout>

<script>
    const element = document.getElementById("not-found-path");
    if (element) {
        const path = window.location.pathname;
        element.textContent = path;
    }
</script>
